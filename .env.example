# Copy this file to .env for local overrides.

FACE_DEMO_DATABASE_PATH=data/face_verify.sqlite3
# Production must override this value. chbzg calls /v1/internal/* with X-Face-Api-Key.
FACE_DEMO_INTERNAL_API_KEY=change-me-face-internal-key
# Comma-separated origins. Keep * only for local demo.
FACE_DEMO_CORS_ORIGINS=*
FACE_DEMO_VERIFICATION_SESSION_TTL_SECONDS=300
# If a worker dies while a session is verifying, later requests recycle it after this window.
FACE_DEMO_VERIFICATION_PROCESSING_TIMEOUT_SECONDS=90
FACE_DEMO_PROOF_TTL_SECONDS=300
# Optional for local demo. Production should set both values so new templates are encrypted.
FACE_DEMO_TEMPLATE_ENCRYPTION_KEY=
FACE_DEMO_TEMPLATE_ENCRYPTION_REQUIRED=0

# Optional writer for the existing regulator result table only.
# Leave disabled for the local demo; use a separate DSN for test and production.
FACE_DEMO_REGULATOR_DB_ENABLED=0
FACE_DEMO_REGULATOR_DB_DSN=
FACE_DEMO_REGULATOR_DB_TABLE=fa_face_verify_regulator_status
FACE_DEMO_REGULATOR_DB_CONNECT_TIMEOUT_SECONDS=3
FACE_DEMO_REGULATOR_DB_READ_TIMEOUT_SECONDS=5
FACE_DEMO_REGULATOR_DB_WRITE_TIMEOUT_SECONDS=5

FACE_DEMO_INSIGHTFACE_MODEL=buffalo_l
FACE_DEMO_INSIGHTFACE_DET_SIZE=480
FACE_DEMO_INSIGHTFACE_LIVE_DET_SIZE=320
FACE_DEMO_INSIGHTFACE_CTX_ID=-1
FACE_DEMO_INSIGHTFACE_MAX_CONCURRENT_INFERENCES=2

FACE_DEMO_FACE_MATCH_THRESHOLD=0.42
FACE_DEMO_FACE_MATCH_MIN_THRESHOLD=0.30
FACE_DEMO_FACE_MATCH_MIN_PASS_RATIO=0.65
FACE_DEMO_FACE_MATCH_EMBEDDING_SAMPLE=5

FACE_DEMO_VERIFICATION_MAX_CONCURRENT_REQUESTS=10
FACE_DEMO_VERIFICATION_SLOT_WAIT_SECONDS=3
FACE_DEMO_VERIFICATION_METRICS_WINDOW=200
FACE_DEMO_VERIFICATION_FAILURE_LIMIT_ENABLED=1
FACE_DEMO_VERIFICATION_FAILURE_MAX_ATTEMPTS=5
FACE_DEMO_VERIFICATION_FAILURE_WINDOW_SECONDS=300
FACE_DEMO_VERIFICATION_FAILURE_COOLDOWN_SECONDS=180

FACE_DEMO_LIVENESS_ACTION_MIN_COUNT=1
FACE_DEMO_LIVENESS_ACTION_MAX_COUNT=2
FACE_DEMO_LIVENESS_ACTION_WEIGHTS=mouth_open=24,shake_head=24,nod_head=24,blink=18,smile=18
FACE_DEMO_LIVENESS_ACTION_RECENT_FAILURE_WINDOW=2
FACE_DEMO_LIVENESS_ACTION_RECENT_FAILURE_FACTOR=0.5
FACE_DEMO_CHALLENGE_TTL_SECONDS=180
FACE_DEMO_MIN_FRAMES_PER_ACTION=6
FACE_DEMO_MAX_FRAMES_PER_ACTION=48
FACE_DEMO_MAX_TOTAL_FRAMES=90
FACE_DEMO_MIN_ACTION_DURATION_MS=1500
FACE_DEMO_MAX_ACTION_DURATION_MS=5000
FACE_DEMO_MAX_FRAME_GAP_MS=900
FACE_DEMO_MIN_UNIQUE_FRAME_RATIO=0.55
FACE_DEMO_DUPLICATE_FRAME_HASH_SIZE=12
FACE_DEMO_MIN_FACE_FRAME_RATIO=0.57
FACE_DEMO_FACE_CONSISTENCY_THRESHOLD=0.42
FACE_DEMO_FACE_CONSISTENCY_MIN_PASS_RATIO=0.66

FACE_DEMO_BLINK_EAR_THRESHOLD=0.20
FACE_DEMO_MOUTH_MAR_THRESHOLD=0.34
FACE_DEMO_MOUTH_MAR_DELTA_THRESHOLD=0.07
FACE_DEMO_SMILE_DELTA_THRESHOLD=0.028
FACE_DEMO_SHAKE_YAW_RANGE_THRESHOLD=14.0
FACE_DEMO_NOD_PITCH_RANGE_THRESHOLD=8.0

# Download or export the models yourself and place them under models/.
# See models/README.md before redistributing model weights.
FACE_DEMO_ANTI_SPOOFING_MODEL_PATH=models/MiniFASNetV1SE.onnx,models/MiniFASNetV2.yakhyo.onnx
FACE_DEMO_ANTI_SPOOFING_MODEL_SCALES=4.0,2.7
FACE_DEMO_ANTI_SPOOFING_THRESHOLD=0.35
FACE_DEMO_ANTI_SPOOFING_MIN_VALID_FRAMES=4
FACE_DEMO_ANTI_SPOOFING_MIN_PASSED_FRAME_RATIO=0.60
FACE_DEMO_ANTI_SPOOFING_SAMPLE_FRAMES=6
FACE_DEMO_ANTI_SPOOFING_LIVE_CLASS_INDEX=1
FACE_DEMO_ANTI_SPOOFING_MAX_CONCURRENT_INFERENCES=2

# Lightweight image gate. These values are intentionally moderate: reject obviously unusable
# frames/templates before heavy face/PAD inference without punishing normal low-end cameras.
FACE_DEMO_IMAGE_QUALITY_SAMPLE_FRAMES=6
FACE_DEMO_IMAGE_QUALITY_MIN_LAPLACIAN=12
FACE_DEMO_IMAGE_QUALITY_MIN_BRIGHTNESS=35
FACE_DEMO_IMAGE_QUALITY_MAX_BRIGHTNESS=225
FACE_DEMO_IMAGE_QUALITY_MIN_CONTRAST=10
FACE_DEMO_IMAGE_QUALITY_TEMPLATE_MIN_FACE_RATIO=0.025
FACE_DEMO_IMAGE_QUALITY_LIVE_MIN_FACE_RATIO=0.02
FACE_DEMO_IMAGE_QUALITY_MAX_FACE_RATIO=0.92
FACE_DEMO_IMAGE_QUALITY_TEMPLATE_MAX_ABS_YAW=35
FACE_DEMO_IMAGE_QUALITY_TEMPLATE_MAX_ABS_PITCH=35
FACE_DEMO_IMAGE_QUALITY_LIVE_MAX_ABS_YAW=55
FACE_DEMO_IMAGE_QUALITY_LIVE_MAX_ABS_PITCH=55

# Optional CPU guardrail for 4-core CPU servers. Use 1/1 on 2-core machines.
FACE_DEMO_ONNX_INTRA_OP_THREADS=2
FACE_DEMO_ONNX_INTER_OP_THREADS=1
