# Test face service settings. Replace all CHANGE_ME values on the server.
FACE_DEMO_DATABASE_PATH=/opt/face-verify-demo/shared/data/testing.sqlite3
FACE_DEMO_INTERNAL_API_KEY=CHANGE_ME_TESTING_FACE_API_KEY
FACE_DEMO_CORS_ORIGINS=https://shualian.chbzg.com.cn,https://shualian.chbzg.com.cn:9004
FACE_DEMO_TEMPLATE_ENCRYPTION_KEY=CHANGE_ME_TESTING_TEMPLATE_KEY
FACE_DEMO_TEMPLATE_ENCRYPTION_REQUIRED=1
FACE_DEMO_INSIGHTFACE_ROOT=/opt/face-verify-demo/shared/insightface-home/.insightface
FACE_DEMO_ANTI_SPOOFING_MODEL_PATH=/opt/face-verify-demo/current/models/MiniFASNetV1SE.onnx,/opt/face-verify-demo/current/models/MiniFASNetV2.yakhyo.onnx

# The only business table written by this integration.
FACE_DEMO_REGULATOR_DB_ENABLED=1
FACE_DEMO_REGULATOR_DB_DSN=mysql+pymysql://face_verify:CHANGE_ME@127.0.0.1:3306/chbzg_test
FACE_DEMO_REGULATOR_DB_TABLE=fa_face_verify_regulator_status
